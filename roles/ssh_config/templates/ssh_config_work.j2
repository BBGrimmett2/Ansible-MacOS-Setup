# =============================================================================
# SSH Client Configuration - Work Profile
# =============================================================================
# Managed by Ansible - Do not edit manually
# Generated: {{ ansible_date_time.iso8601 }}
# =============================================================================

# Global SSH client options
Host *
{% for key, value in ssh_global_options.items() %}
    {{ key }} {{ value }}
{% endfor %}
    StrictHostKeyChecking {{ ssh_strict_host_key_checking }}
{% if ssh_compression %}
    Compression yes
{% endif %}

# =============================================================================
# Work GitLab
# =============================================================================
{% for key in ssh_work_keys %}
{% if 'gitlab' in key.host_pattern and 'shadowman' not in key.host_pattern %}
Host {{ key.host_pattern }}
    HostName {{ key.host_pattern }}
    User git
    IdentityFile {{ key.file }}
    IdentitiesOnly yes
{% endif %}
{% endfor %}

# =============================================================================
# Shadowman Git Server
# =============================================================================
{% for key in ssh_work_keys %}
{% if 'shadowman' in key.host_pattern %}
Host {{ key.host_pattern }}
    HostName {{ key.host_pattern }}
    User git
    IdentityFile {{ key.file }}
    IdentitiesOnly yes
{% endif %}
{% endfor %}

# =============================================================================
# Custom Work Hosts
# =============================================================================
{% for key in ssh_work_keys %}
{% if 'gitlab' not in key.host_pattern and 'shadowman' not in key.host_pattern %}
Host {{ key.host_pattern }}
    HostName {{ key.host_pattern }}
    IdentityFile {{ key.file }}
    IdentitiesOnly yes
{% endif %}
{% endfor %}
