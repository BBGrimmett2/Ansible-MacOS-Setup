#!/bin/bash
# =============================================================================
# RHDPS - Red Hat Demo Platform Services Helper
# =============================================================================
# Quick setup of cloud demo environments with direnv integration
# =============================================================================

set -e

VERSION="1.0.0"
SCRIPT_NAME="rhdps"

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# =============================================================================
# Helper Functions
# =============================================================================

print_header() {
    echo -e "${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    echo -e "${BLUE}$1${NC}"
    echo -e "${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
}

print_success() {
    echo -e "${GREEN}✓${NC} $1"
}

print_error() {
    echo -e "${RED}✗${NC} $1" >&2
}

print_warning() {
    echo -e "${YELLOW}⚠${NC} $1"
}

print_info() {
    echo -e "${BLUE}ℹ${NC} $1"
}

# =============================================================================
# Setup Functions
# =============================================================================

setup_aws() {
    print_header "AWS Demo Environment Setup"

    # Prompt for AWS details
    read -p "AWS Account ID: " AWS_ACCOUNT_ID
    read -p "AWS Region [us-east-1]: " AWS_REGION
    AWS_REGION=${AWS_REGION:-us-east-1}

    read -p "AWS Access Key ID: " AWS_ACCESS_KEY_ID
    read -sp "AWS Secret Access Key: " AWS_SECRET_ACCESS_KEY
    echo

    # Generate profile name
    PROFILE_NAME="demo-aws-$(date +%Y-%m-%d-%H%M%S)"
    read -p "Profile name [$PROFILE_NAME]: " CUSTOM_PROFILE
    PROFILE_NAME=${CUSTOM_PROFILE:-$PROFILE_NAME}

    # Create AWS config directory
    mkdir -p ~/.aws

    # Add credentials to ~/.aws/credentials
    print_info "Adding credentials to ~/.aws/credentials..."
    if ! grep -q "\[$PROFILE_NAME\]" ~/.aws/credentials 2>/dev/null; then
        cat >> ~/.aws/credentials << EOF

[$PROFILE_NAME]
aws_access_key_id = $AWS_ACCESS_KEY_ID
aws_secret_access_key = $AWS_SECRET_ACCESS_KEY
EOF
        chmod 600 ~/.aws/credentials
        print_success "Credentials added"
    else
        print_warning "Profile already exists in credentials file"
    fi

    # Add config to ~/.aws/config
    print_info "Adding config to ~/.aws/config..."
    if ! grep -q "\[profile $PROFILE_NAME\]" ~/.aws/config 2>/dev/null; then
        cat >> ~/.aws/config << EOF

[profile $PROFILE_NAME]
region = $AWS_REGION
output = json
EOF
        chmod 600 ~/.aws/config
        print_success "Config added"
    else
        print_warning "Profile already exists in config file"
    fi

    # Create .envrc
    print_info "Creating .envrc in current directory..."
    cat > .envrc << EOF
# AWS Demo Environment: $PROFILE_NAME
# Created: $(date)
use_project_env
export AWS_PROFILE=$PROFILE_NAME
export AWS_DEFAULT_REGION=$AWS_REGION
export AWS_ACCOUNT_ID=$AWS_ACCOUNT_ID
export ENV=demo
EOF

    print_success ".envrc created"

    print_header "AWS Demo Environment Ready"
    echo
    print_info "Profile: $PROFILE_NAME"
    print_info "Region: $AWS_REGION"
    print_info "Account: $AWS_ACCOUNT_ID"
    echo
    print_warning "Run 'direnv allow' to activate environment variables"
    echo
    print_info "Test with: aws sts get-caller-identity"
}

setup_gcp() {
    print_header "GCP Demo Environment Setup"

    # Prompt for GCP details
    read -p "GCP Project ID: " GCP_PROJECT_ID
    read -p "GCP Region [us-central1]: " GCP_REGION
    GCP_REGION=${GCP_REGION:-us-central1}

    read -p "GCP Zone [$GCP_REGION-a]: " GCP_ZONE
    GCP_ZONE=${GCP_ZONE:-$GCP_REGION-a}

    # Generate config name
    CONFIG_NAME="demo-gcp-$(date +%Y-%m-%d-%H%M%S)"
    read -p "Configuration name [$CONFIG_NAME]: " CUSTOM_CONFIG
    CONFIG_NAME=${CUSTOM_CONFIG:-$CONFIG_NAME}

    print_info "Paste service account JSON (Ctrl+D when done):"
    SA_JSON=$(cat)

    # Create gcloud config directory
    mkdir -p ~/.config/gcloud

    # Save service account JSON
    SA_FILE=~/.config/gcloud/${CONFIG_NAME}-sa.json
    echo "$SA_JSON" > "$SA_FILE"
    chmod 600 "$SA_FILE"
    print_success "Service account saved to $SA_FILE"

    # Activate service account
    print_info "Activating service account..."
    gcloud auth activate-service-account --key-file="$SA_FILE" --project="$GCP_PROJECT_ID" 2>/dev/null || true

    # Create configuration
    print_info "Creating gcloud configuration..."
    gcloud config configurations create "$CONFIG_NAME" 2>/dev/null || print_warning "Configuration already exists"

    gcloud config set project "$GCP_PROJECT_ID" --configuration="$CONFIG_NAME"
    gcloud config set compute/region "$GCP_REGION" --configuration="$CONFIG_NAME"
    gcloud config set compute/zone "$GCP_ZONE" --configuration="$CONFIG_NAME"

    print_success "Configuration created"

    # Create .envrc
    print_info "Creating .envrc in current directory..."
    cat > .envrc << EOF
# GCP Demo Environment: $CONFIG_NAME
# Created: $(date)
use_project_env
export CLOUDSDK_ACTIVE_CONFIG_NAME=$CONFIG_NAME
export CLOUDSDK_CORE_PROJECT=$GCP_PROJECT_ID
export CLOUDSDK_COMPUTE_REGION=$GCP_REGION
export CLOUDSDK_COMPUTE_ZONE=$GCP_ZONE
export ENV=demo
EOF

    print_success ".envrc created"

    print_header "GCP Demo Environment Ready"
    echo
    print_info "Configuration: $CONFIG_NAME"
    print_info "Project: $GCP_PROJECT_ID"
    print_info "Region: $GCP_REGION"
    echo
    print_warning "Run 'direnv allow' to activate environment variables"
    echo
    print_info "Test with: gcloud compute instances list"
}

setup_azure() {
    print_header "Azure Demo Environment Setup"

    # Prompt for Azure details
    read -p "Azure Subscription ID: " AZURE_SUBSCRIPTION_ID
    read -p "Azure Tenant ID: " AZURE_TENANT_ID
    read -p "Azure Client ID (Service Principal): " AZURE_CLIENT_ID
    read -sp "Azure Client Secret: " AZURE_CLIENT_SECRET
    echo

    read -p "Azure Location [eastus]: " AZURE_LOCATION
    AZURE_LOCATION=${AZURE_LOCATION:-eastus}

    # Login with service principal
    print_info "Authenticating with Azure..."
    az login --service-principal \
        --username "$AZURE_CLIENT_ID" \
        --password "$AZURE_CLIENT_SECRET" \
        --tenant "$AZURE_TENANT_ID" > /dev/null 2>&1

    az account set --subscription "$AZURE_SUBSCRIPTION_ID"
    print_success "Authenticated with Azure"

    # Create .envrc
    print_info "Creating .envrc in current directory..."
    cat > .envrc << EOF
# Azure Demo Environment
# Created: $(date)
use_project_env
export AZURE_SUBSCRIPTION_ID=$AZURE_SUBSCRIPTION_ID
export AZURE_TENANT_ID=$AZURE_TENANT_ID
export AZURE_CLIENT_ID=$AZURE_CLIENT_ID
export AZURE_CLIENT_SECRET=$AZURE_CLIENT_SECRET
export AZURE_LOCATION=$AZURE_LOCATION
export ENV=demo
EOF

    print_success ".envrc created"

    print_header "Azure Demo Environment Ready"
    echo
    print_info "Subscription: $AZURE_SUBSCRIPTION_ID"
    print_info "Location: $AZURE_LOCATION"
    echo
    print_warning "Run 'direnv allow' to activate environment variables"
    echo
    print_info "Test with: az account show"
}

# =============================================================================
# List Function
# =============================================================================

list_env() {
    if [ ! -f .envrc ]; then
        print_error "No .envrc found in current directory"
        exit 1
    fi

    print_header "Current Directory Environment"
    echo
    print_info "Directory: $(pwd)"
    print_info "File: .envrc"
    echo
    cat .envrc | grep -E "^export|^#" | sed 's/^/  /'
    echo

    if direnv status 2>/dev/null | grep -q "Found RC allowed true"; then
        print_success "Environment is allowed and active"
    else
        print_warning "Run 'direnv allow' to activate"
    fi
}

# =============================================================================
# Clean Function
# =============================================================================

clean_env() {
    if [ ! -f .envrc ]; then
        print_error "No .envrc found in current directory"
        exit 1
    fi

    print_warning "This will delete .envrc in: $(pwd)"
    read -p "Are you sure? (y/N): " confirm

    if [[ "$confirm" =~ ^[Yy]$ ]]; then
        rm -f .envrc
        print_success ".envrc removed"
    else
        print_info "Cancelled"
    fi
}

# =============================================================================
# Help Function
# =============================================================================

show_help() {
    cat << EOF
$SCRIPT_NAME - Red Hat Demo Platform Services Helper v$VERSION

USAGE:
    $SCRIPT_NAME <command> [options]

COMMANDS:
    setup aws       Setup AWS demo environment
    setup gcp       Setup GCP demo environment
    setup azure     Setup Azure demo environment
    list            Show current directory environment
    clean           Remove .envrc from current directory
    help            Show this help message
    version         Show version

WORKFLOW:
    1. cd to your project directory
    2. Run: $SCRIPT_NAME setup <provider>
    3. Follow prompts to enter credentials
    4. Run: direnv allow
    5. Environment variables auto-load when entering directory

EXAMPLES:
    # Setup AWS demo environment
    cd ~/Documents/Projects/demo-aws-project
    $SCRIPT_NAME setup aws
    direnv allow

    # Setup GCP demo environment
    cd ~/Documents/Projects/demo-gcp-project
    $SCRIPT_NAME setup gcp
    direnv allow

    # View current environment
    $SCRIPT_NAME list

    # Clean up environment
    $SCRIPT_NAME clean

INTEGRATION:
    This tool integrates with direnv safety checks. When you cd into
    a Documents/Projects/ directory, you'll be prompted to confirm you're in the
    correct project before environment variables are loaded.

EOF
}

# =============================================================================
# Main
# =============================================================================

case "${1:-help}" in
    setup)
        case "${2:-}" in
            aws)
                setup_aws
                ;;
            gcp)
                setup_gcp
                ;;
            azure)
                setup_azure
                ;;
            *)
                print_error "Unknown provider: ${2:-none}"
                echo "Usage: $SCRIPT_NAME setup <aws|gcp|azure>"
                exit 1
                ;;
        esac
        ;;
    list)
        list_env
        ;;
    clean)
        clean_env
        ;;
    version)
        echo "$SCRIPT_NAME v$VERSION"
        ;;
    help|--help|-h)
        show_help
        ;;
    *)
        print_error "Unknown command: $1"
        echo "Run '$SCRIPT_NAME help' for usage"
        exit 1
        ;;
esac
